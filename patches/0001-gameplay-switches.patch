diff --git a/games/totk/runtime/game_patches.c b/games/totk/runtime/game_patches.c
index 3cd712d..e8441a8 100644
--- a/games/totk/runtime/game_patches.c
+++ b/games/totk/runtime/game_patches.c
@@ -757,6 +757,153 @@ static void patch_pool_offset(Module *m) {
 #endif
 }
 
+#if defined(TOTK_GAME_V0)
+/* Optional gameplay switches (Mac settings panel): "Unlimited durability", "Unlimited health", "Unlimited arrows"
+   and "Unlimited battery". They sit on the instructions 1.0.0 itself uses to read or change the value:
+     - main+0x7c37a8  ldr w1,[x8,#8]   the equipped item's current durability. The publisher around it loops over the
+                                       equipment slots (index 0 the weapon, 3 the bow, 4 the shield: main+0x7c36dc and
+                                       main+0x7c36f0 feed the same read), so one site covers all three; verified on
+                                       2026-11-04 with a sword, a bow and a shield. The veneer copies [x8,#0x18] (the
+                                       separate maximum record, kept at +0x1838, 16 bytes after the current one) over
+                                       [+8] first, so it never falls.
+                                       Fused items use this durability; the Master Sword's energy does not (a separate
+                                       meter). The third record this function publishes (+0x1840, main+0x7c37cc) is a
+                                       different statistic (message 0x54dedbe, not 0x355c603) and is left alone.
+     - main+0x650414  ldr x8,[x0]      the life gauge's per-frame update starts by reading the object's type; the
+                                       veneer copies [x0,#0x18] (the maximum life, in quarter hearts) over [x0,#8] (the
+                                       current life) first, then runs the original load, so the update itself is
+                                       unchanged. Gloom, drowning, void-outs and scripted deaths do not go through this
+                                       value and are left as the game has them.
+     - main+0x2393714 add w10,w10,w1   the generic "current += delta" helper for value arrays. The bow consume path
+                                       (main+0xEF02D0) calls it with x0 = the arrow value-array descriptor,
+                                       [[main+0x4646C60]+0x138]+0xBC0, w1 = -1 and w2 = 0 (verified with a write
+                                       watchpoint on 2026-11-04: 13 -> 12 -> 11 on two shots). The veneer compares x0
+                                       with that descriptor and zeroes w1 only for the -1 consume; +1 pickups and
+                                       purchases still add, and every other item array is untouched. x16 is not used by
+                                       the helper, so it is the veneer's scratch register.
+     - main+0xb6b27c  b.hi            the battery gauge update (main+0xb6b1d8) loads the battery item's current maximum
+                                       into s9 and the gauge's current energy from [x19,#0x44], then skips the store
+                                       while maximum > current. NOP makes it fall through and store the real maximum
+                                       every frame, so the gauge follows battery upgrades (3000.0 for one cell,
+                                       24000.0 at eight) instead of hardcoding 3000.0. This is a gauge-level refill:
+                                       a Zonai device drain test has not been run yet (the available save has no
+                                       devices), so the switch must not be described as device-tested.
+   The site word is checked against the retail module before anything is written: a mismatch (a launch-time
+   TOTK_PCHTXT on the site, a module this table was not made for) leaves that switch off with a line in the log
+   instead of stopping the game. A site with a non-zero replacement is written directly; a zero replacement gets a
+   veneer. Off by default: no settings file, no settings folder, or a word other than on / 1 / true leaves the site
+   alone. Switching takes effect at the next start: the bytes are written before the module's text is sealed, never
+   while guest threads run. */
+static const GamePatch gameplay_sites[] = {
+    {0x7c37a8, 0xb9400901, 0, "unlimited durability: equipment current durability read (w1 = [x8,#8])"},
+    {0x650414, 0xf9400008, 0, "unlimited health: current life read (x8 = [x0])"},
+    {0x2393714, 0x0b01014a, 0, "unlimited arrows: value-array add at the arrow consume call (w10 += w1)"},
+    {0xb6b27c, 0x540000a8, 0xd503201f, "unlimited battery: gauge clamp b.hi -> nop"},
+};
+
+static void gameplay_veneer(Module *m, uint64_t at, const uint32_t *code, unsigned n, const char *what) {
+    for (unsigned i = 0; i < n; i++) {
+        uint32_t have;
+        memcpy(&have, m->base + at + 4 * i, 4);
+        if (have) {
+            fprintf(stderr, "[totk] %s: main's text padding at main+%#llx is not empty (%08x)\n", what,
+                    (unsigned long long)(at + 4 * i), have);
+            runtime_fail("gameplay switch veneer: text padding not empty");
+        }
+    }
+    for (unsigned i = 0; i < n; i++) put_word(m, at + 4 * i, code[i], what);
+}
+
+static int gameplay_durability_active, gameplay_health_active, gameplay_arrows_active, gameplay_battery_active;
+int runtime_gameplay_active(int which) {   /* settings panel: 0 durability, 1 health, 2 arrows, 3 battery; in force now */
+    switch (which) {
+    case 0: return gameplay_durability_active;
+    case 1: return gameplay_health_active;
+    case 2: return gameplay_arrows_active;
+    case 3: return gameplay_battery_active;
+    default: return 0;
+    }
+}
+
+static int gameplay_apply(Module *m, const GamePatch *site, uint64_t at, const uint32_t *code, unsigned n) {
+    uint32_t have;
+    memcpy(&have, m->base + site->offset, 4);
+    if (have != site->original) {
+        fprintf(stderr, "[totk] %s: main+%#llx holds %08x, expected %08x; left off\n", site->what,
+                (unsigned long long)site->offset, have, site->original);
+        return 0;
+    }
+    gameplay_veneer(m, at, code, n, site->what);
+    put_word(m, site->offset, branch_to(site->offset, at), site->what);
+    fprintf(stderr, "[totk] %s: %s on, veneer at main+%#llx\n", TOTK_GAME_VERSION, site->what,
+            (unsigned long long)at);
+    return 1;
+}
+
+/* A switch whose whole patch is one instruction (the battery clamp): the replacement is written over the site. */
+static int gameplay_word(Module *m, const GamePatch *site) {
+    uint32_t have;
+    memcpy(&have, m->base + site->offset, 4);
+    if (have != site->original) {
+        fprintf(stderr, "[totk] %s: main+%#llx holds %08x, expected %08x; left off\n", site->what,
+                (unsigned long long)site->offset, have, site->original);
+        return 0;
+    }
+    put_word(m, site->offset, site->replacement, site->what);
+    fprintf(stderr, "[totk] %s: %s on, main+%#llx %08x -> %08x\n", TOTK_GAME_VERSION, site->what,
+            (unsigned long long)site->offset, site->original, site->replacement);
+    return 1;
+}
+
+static void gameplay_switch(Module *m, const char *file, const GamePatch *site, uint64_t at,
+                            const uint32_t *code, unsigned n, int *active) {
+    if (!runtime_setting_on(file)) {
+        fprintf(stderr, "[totk] %s: off (%s is not on)\n", site->what, file);
+        return;
+    }
+    if (gameplay_apply(m, site, at, code, n)) *active = 1;
+}
+
+static void gameplay_word_switch(Module *m, const char *file, const GamePatch *site, int *active) {
+    if (!runtime_setting_on(file)) {
+        fprintf(stderr, "[totk] %s: off (%s is not on)\n", site->what, file);
+        return;
+    }
+    if (gameplay_word(m, site)) *active = 1;
+}
+
+static void patch_gameplay_switches(Module *m) {
+    /* After the cloth (3 x 17 words) and trampoline (5 words) veneers, still inside the text padding before rodata.
+       Durability at +0x200, health at +0x220, arrows at +0x240 (11 words, 44 bytes). */
+    const uint64_t base = ((m->text_end + 15) & ~15ULL) + 0x200, end = (m->text_end + 0xfff) & ~0xfffULL;
+    if (base + 0x80 > end) runtime_fail("gameplay switch veneer layout");
+    uint32_t durability[3] = {0xb9401901u /* ldr w1,[x8,#0x18] */, 0xb9000901u /* str w1,[x8,#8] */, 0};
+    durability[2] = branch_to(base + 8, gameplay_sites[0].offset + 4);
+    uint32_t health[4] = {0xb9401808u /* ldr w8,[x0,#0x18] */, 0xb9000808u /* str w8,[x0,#8] */,
+                          0xf9400008u /* ldr x8,[x0] (the site's original) */, 0};
+    health[3] = branch_to(base + 0x20 + 12, gameplay_sites[1].offset + 4);
+    /* The arrow gate: compare x0 with [[main+0x4646C60]+0x138]+0xBC0, then zero w1 only for a -1 delta. */
+    uint32_t arrows[11] = {
+        adrp_reg(16, (uintptr_t)m->base + base + 0x40, (uintptr_t)m->base + 0x4646000),
+        0xf9463210u,   /* ldr x16,[x16,#0xc60]       inventory manager */
+        0xf9409e10u,   /* ldr x16,[x16,#0x138]       item-count container */
+        0x912f0210u,   /* add x16,x16,#0xbc0         arrow value-array descriptor */
+        0xeb10001fu,   /* cmp x0,x16 */
+        0x54000081u,   /* b.ne 1f */
+        0x3100043fu,   /* cmn w1,#1                  only the -1 consume; +1 still adds */
+        0x54000041u,   /* b.ne 1f */
+        0x52800001u,   /* mov w1,#0 */
+        0x0b01014au,   /* add w10,w10,w1 (the replaced instruction) */
+        0,
+    };
+    arrows[10] = branch_to(base + 0x40 + 40, gameplay_sites[2].offset + 4);
+    gameplay_switch(m, "unlimited-durability.txt", &gameplay_sites[0], base, durability, 3, &gameplay_durability_active);
+    gameplay_switch(m, "unlimited-health.txt", &gameplay_sites[1], base + 0x20, health, 4, &gameplay_health_active);
+    gameplay_switch(m, "unlimited-arrows.txt", &gameplay_sites[2], base + 0x40, arrows, 11, &gameplay_arrows_active);
+    gameplay_word_switch(m, "unlimited-battery.txt", &gameplay_sites[3], &gameplay_battery_active);
+}
+#endif
+
 void runtime_game_patches(Module *m) {

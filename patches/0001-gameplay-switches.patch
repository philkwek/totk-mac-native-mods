+/* The switches that must be read before the guest starts (game_patches.c, settings_panel.h): on, 1 or true, with
+   the blanks around the word dropped; anything else, a missing folder or no file at all is off. */
+int runtime_setting_on(const char *name) {
+    char word[32];
+    if (!runtime_setting_word(name, word, sizeof word)) return 0;
+    char *s = word, *end = word + strlen(word);
+    while (*s == ' ' || *s == '\t' || *s == '\r' || *s == '\n') s++;
+    while (end > s && (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' || end[-1] == '\n')) *--end = 0;
+    return !strcasecmp(s, "on") || !strcmp(s, "1") || !strcasecmp(s, "true");
+}
 /* ... and saves one, as controller-type.txt is saved (the settings panel's controller rows). */
 void runtime_setting_save(const char *name, const char *word, const char *what) { setting_write(name, word, what); }
 /* The same for a setting both games share (shared_setting_path). */
